{
    "name": "@sourcebot/shared",
    "version": "0.1.0",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "tsc",
        "build:watch": "tsc-watch --preserveWatchOutput",
        "postinstall": "yarn build",
