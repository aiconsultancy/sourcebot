        "@sourcebot/db": "workspace:*",
        "@sourcebot/schemas": "workspace:*",
        "@t3-oss/env-core": "^0.13.11",
        "ajv": "^8.20.0",
        "bullmq": "^5.81.5",
        "ioredis": "^5.11.1",
        "micromatch": "^4.0.8",
        "strip-json-comments": "^5.1.0",
        "triple-beam": "^1.4.1",
        "winston": "^3.19.0",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/micromatch": "^4.0.10",
        "@types/node": "^22.20.5",
        "cross-env": "^7.0.3",
        "tsc-watch": "6.3.1",
        "tsx": "^4.23.15",
